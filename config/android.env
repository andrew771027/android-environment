
# -----------------------------------
# Android Environment
# -----------------------------------

ANDROID_API_LEVEL=36

ANDROID_PLATFORM="platforms;android-${ANDROID_API_LEVEL}"

SYSTEM_IMAGE_FLAVOR="google_apis"

ANDROID_HOME="${ANDROID_HOME:-${HOME}/Android/Sdk}"

# -----------------------------------
# Android Virtual Device
# -----------------------------------

AVD_NAME="cookbook_pixel_api_${ANDROID_API_LEVEL}"

AVD_DEVICE="pixel_7"

# -----------------------------------
# Emulator Lifecycle
# -----------------------------------

EMULATOR_BOOT_TIMEOUT_SECONDS=180
EMULATOR_BOOT_POLL_INTERVAL_SECONDS=2

EMULATOR_NO_SNAPSHOT_LOAD=true
EMULATOR_NO_BOOT_ANIMATION=true
